<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TamizChat.Simulator</RootNamespace>
    <AssemblyName>tamizsim</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TamizChat.Core\TamizChat.Core.csproj" />

    <!-- So `tamizsim listen` can actually play what it hears. -->
    <ProjectReference Include="..\TamizChat.Audio\TamizChat.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied so `tamizsim fx` can decode exactly the files the app ships. -->
    <Content Include="..\tamizchat\Assets\Sounds\*.ogg" Link="Assets\Sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

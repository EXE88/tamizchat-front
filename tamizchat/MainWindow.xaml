<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TamizChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TamizChat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TamizChat">

    <!--
        The tint sits over the window backdrop rather than replacing it, so the
        Mica or Acrylic material still shows through. The title bar row is part
        of this same grid, which is the point of extending into the title bar:
        there is no seam between the chrome and the page.
    -->
    <Grid Background="{StaticResource TcTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource TcTextPrimaryBrush}"
                Text="TamizChat" />
        </Grid>

        <!--
            Temporary. These move into the Settings page in the next phase; for
            now they are how the theme system gets exercised by hand.
        -->
        <ScrollViewer Grid.Row="1" Padding="32,16,32,32">
            <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left">

                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TcTextPrimaryBrush}"
                    Text="Appearance" />

                <StackPanel Spacing="6">
                    <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" Text="Theme" />
                    <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Salt and Pepper" />
                        <ComboBoxItem Content="Violet and Lavender" />
                        <ComboBoxItem Content="Carbon and Lime" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" Text="Mode" />
                    <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="Follow Windows" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" Text="Background" />
                    <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch" SelectionChanged="OnBackdropChanged">
                        <ComboBoxItem Content="Matte" />
                        <ComboBoxItem Content="Matte High" />
                        <ComboBoxItem Content="Glass" />
                        <ComboBoxItem Content="Glass High" />
                    </ComboBox>
                </StackPanel>

                <!-- A card, so the surface and border roles are visible too. -->
                <Border
                    Padding="20"
                    Background="{StaticResource TcSurfaceBrush}"
                    BorderBrush="{StaticResource TcBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource TcCardCornerRadius}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TcTextPrimaryBrush}"
                            Text="Surface" />
                        <TextBlock
                            Foreground="{StaticResource TcTextSecondaryBrush}"
                            Text="Secondary text on a surface, so contrast can be judged." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Padding="14,7"
                                Background="{StaticResource TcAccentBrush}"
                                CornerRadius="8">
                                <TextBlock Foreground="{StaticResource TcOnAccentBrush}" Text="Accent" />
                            </Border>
                            <Button Content="Standard button" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="Status"
                    Foreground="{StaticResource TcTextSecondaryBrush}"
                    FontFamily="Consolas"
                    FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

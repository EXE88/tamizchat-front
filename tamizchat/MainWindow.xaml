<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TamizChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TamizChat.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TamizChat">

    <!--
        The tint sits over the window backdrop rather than replacing it, so the
        Mica or Acrylic material still shows through. The title bar row is part
        of this same grid: that is the point of extending into the title bar,
        there is no seam between the chrome and the page.
    -->
    <Grid Background="{StaticResource TcTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The whole title row is forced left to right in code, including the
            back button. See ApplyFlowDirection.
        -->
        <Grid x:Name="TitleRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Sits outside the drag region below, because a control inside the
                element passed to SetTitleBar never receives clicks.
            -->
            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Width="40"
                Height="32"
                Margin="8,0,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBackClick"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="14"
                    Foreground="{StaticResource TcTextPrimaryBrush}"
                    Glyph="&#xE72B;" />
            </Button>

            <Grid x:Name="AppTitleBar" Grid.Column="1" Padding="8,0">
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TcTextPrimaryBrush}"
                    Text="TamizChat" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Frame x:Name="ContentFrame" />

            <!--
                Floating rather than docked: it hangs above the bottom edge and
                the page scrolls beneath it.
            -->
            <controls:FloatingNavBar
                x:Name="NavBar"
                Margin="0,0,0,22"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>

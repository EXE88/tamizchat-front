<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's whole colour vocabulary. Every brush here is a single shared
    instance whose Color is rewritten by ThemeManager when the theme changes, so
    switching themes updates everything already on screen without rebuilding the
    visual tree or re-merging dictionaries.

    The colours below are only placeholders; ThemeManager overwrites all of them
    during startup.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Painted over the window backdrop. Semi-transparent by design. -->
    <SolidColorBrush x:Key="TcTintBrush" Color="#59FFFFFF" />

    <!-- Cards, panels, the floating navigation bar. -->
    <SolidColorBrush x:Key="TcSurfaceBrush" Color="#B0FFFFFF" />

    <!--
        The paint board, and only the paint board. It is opaque on purpose: the
        eraser works by painting the background colour over a stroke, and a
        translucent surface would only tint what is underneath instead of hiding
        it.
    -->
    <SolidColorBrush x:Key="TcBoardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TcSurfaceHoverBrush" Color="#B0D4D4D4" />
    <SolidColorBrush x:Key="TcBorderBrush" Color="#80B3B3B3" />

    <SolidColorBrush x:Key="TcTextPrimaryBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TcTextSecondaryBrush" Color="#992B2B2B" />

    <SolidColorBrush x:Key="TcAccentBrush" Color="#2B2B2B" />

    <!--
        ToggleSwitch and Slider resolve their accent through their own keys, not
        through AccentFillColorDefaultBrush. Declaring them here puts a brush of
        ours in the lookup chain for the control templates to find, which is what
        ThemeManager then mutates — the same trick the Tc* brushes rely on.
        Without this they keep the Windows system accent and stay blue whatever
        theme is chosen.
    -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#2B2B2B" />

    <SolidColorBrush x:Key="TcAccentHoverBrush" Color="#404040" />
    <SolidColorBrush x:Key="TcOnAccentBrush" Color="#FFFFFF" />

    <!--
        Deliberately the same red in every theme. A muted microphone or a
        disconnect button has to read as a warning regardless of which palette is
        on, and it must never be mistaken for a theme accent.
    -->
    <SolidColorBrush x:Key="TcDangerBrush" Color="#E5484D" />

    <!--
        The floating navigation bar's own material. This is in-app acrylic: it
        blurs the page content behind the bar, which the window backdrop cannot
        do because that only samples the desktop.
    -->
    <AcrylicBrush
        x:Key="TcBarAcrylicBrush"
        FallbackColor="#2B2B2B"
        TintColor="#2B2B2B"
        TintLuminosityOpacity="0.55"
        TintOpacity="0.35" />

    <!--
        The app's own accent button. WinUI's AccentButtonStyle reads the system
        accent, which is Windows' blue and ignores the chosen theme, so a primary
        action styled with it would not match the rest of the app.
    -->
    <Style x:Key="TcAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource TcAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TcAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TcOnAccentBrush}" />
    </Style>

    <!-- Shared shape values, so rounding is consistent everywhere. -->
    <CornerRadius x:Key="TcCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="TcBarCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="TcPillCornerRadius">16</CornerRadius>

</ResourceDictionary>

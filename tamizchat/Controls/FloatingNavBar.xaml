<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TamizChat.Controls.FloatingNavBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The stock Button style fights us here: its PointerOver and Pressed
            states overwrite Background and Foreground, which made a pressed item
            wash out and lose its colour. This template owns exactly the states
            the bar wants and nothing else.
        -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{StaticResource TcPillCornerRadius}"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Squish" />
                            </Grid.RenderTransform>

                            <!-- Sits under the content, above the sliding pill. -->
                            <Border
                                x:Name="Hover"
                                Background="{StaticResource TcSurfaceHoverBrush}"
                                CornerRadius="{StaticResource TcPillCornerRadius}"
                                Opacity="0" />

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.15" />
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Hover"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.6"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Hover"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.35"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Squish"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.94"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Squish"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.94"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.4"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Floating, not docked: the bar sits above the page with a margin below it
        and the page scrolls underneath.
    -->
    <Border
        x:Name="BarRoot"
        Padding="8,6"
        HorizontalAlignment="Center"
        Background="{StaticResource TcBarAcrylicBrush}"
        BorderBrush="{StaticResource TcBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource TcBarCornerRadius}">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid>
            <!--
                One pill for the whole bar, slid from the old item to the new one,
                rather than a background per button appearing and disappearing.
            -->
            <Border
                x:Name="SelectionPill"
                Width="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{StaticResource TcAccentBrush}"
                CornerRadius="{StaticResource TcPillCornerRadius}"
                Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillOffset" />
                </Border.RenderTransform>
            </Border>

            <StackPanel
                x:Name="ItemsHost"
                Orientation="Horizontal"
                Spacing="2" />
        </Grid>
    </Border>
</UserControl>

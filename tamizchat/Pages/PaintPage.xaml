<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TamizChat.Pages.PaintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="40,24,40,120">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="{StaticResource TcTextPrimaryBrush}"
                Text="Paint board" />
            <TextBlock
                Foreground="{StaticResource TcTextSecondaryBrush}"
                Text="A feature page: reached by drilling in from the bottom bar, and left again with the back button at the top left." />
        </StackPanel>
    </ScrollViewer>
</Page>

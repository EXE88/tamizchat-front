<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TamizChat.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="40,24,40,120">
        <StackPanel Spacing="24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="{StaticResource TcTextPrimaryBrush}"
                x:Name="Title" Text="Settings" />

            <TextBlock
                FontSize="19"
                FontWeight="SemiBold"
                Foreground="{StaticResource TcTextPrimaryBrush}"
                x:Name="AppearanceLabel" Text="Appearance" />

            <StackPanel Spacing="6">
                <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" x:Name="ThemeLabel" Text="Theme" />
                <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Salt and Pepper" />
                    <ComboBoxItem Content="Violet and Lavender" />
                    <ComboBoxItem Content="Carbon and Lime" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" x:Name="ModeLabel" Text="Mode" />
                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="Follow Windows" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Foreground="{StaticResource TcTextSecondaryBrush}" x:Name="BackgroundLabel" Text="Background" />
                <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch" SelectionChanged="OnBackdropChanged">
                    <ComboBoxItem Content="Matte" />
                    <ComboBoxItem Content="Matte High" />
                    <ComboBoxItem Content="Glass" />
                    <ComboBoxItem Content="Glass High" />
                </ComboBox>
                <TextBlock
                    x:Name="BackdropHelp"
                    FontSize="12"
                    Foreground="{StaticResource TcTextSecondaryBrush}"
                    Text="Glass is the default. Matte is calmer; the High variants show more of what is behind the window." />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock x:Name="LanguageLabel" Foreground="{StaticResource TcTextSecondaryBrush}" Text="Language" />
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="Persian" />
                </ComboBox>
                <TextBlock
                    x:Name="LanguageHelp"
                    FontSize="12"
                    Foreground="{StaticResource TcTextSecondaryBrush}"
                    Text="Persian lays the app out right to left." />
            </StackPanel>

            <Border
                Padding="20"
                Background="{StaticResource TcSurfaceBrush}"
                BorderBrush="{StaticResource TcBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource TcCardCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TcTextPrimaryBrush}"
                        x:Name="PreviewLabel" Text="Preview" />
                    <TextBlock
                        Foreground="{StaticResource TcTextSecondaryBrush}"
                        x:Name="SecondaryText" Text="Secondary text on a surface, so contrast can be judged." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Padding="14,7"
                            Background="{StaticResource TcAccentBrush}"
                            CornerRadius="8">
                            <TextBlock x:Name="AccentLabel" Foreground="{StaticResource TcOnAccentBrush}" Text="Accent" />
                        </Border>
                        <Button x:Name="StandardButton" Content="Standard button" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="Status"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource TcTextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TamizChat.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        No MaxWidth here. Combining it with Stretch centres the block inside the
        scroll presenter, and that centring pushed the content sideways until its
        right edge — where the buttons live — fell outside the window. Filling the
        available width has nothing to get wrong.

        The bottom padding keeps content clear of the floating bar.
    -->
    <ScrollViewer Padding="40,20,40,120">
        <StackPanel Spacing="18" HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TcTextPrimaryBrush}"
                        x:Name="TitleText" Text="Home" />
                    <TextBlock
                        Foreground="{StaticResource TcTextSecondaryBrush}"
                        x:Name="SubtitleText" Text="Pick a server to join." />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnRefreshClick"
                    x:Name="RefreshButton" Content="Refresh" />
            </Grid>

            <ItemsControl x:Name="ServerList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock
                x:Name="EmptyHint"
                Foreground="{StaticResource TcTextSecondaryBrush}"
                Visibility="Collapsed"
                Text="No servers saved yet. Add one from the Servers page." />
        </StackPanel>
    </ScrollViewer>
</Page>
